---
import Page from '../../layouts/Page.astro';
import { AGC, REPO_URL, renderDocument } from '../../lib/agc';

const { Content } = await renderDocument(AGC.current, 'EVIDENCE');
---

<Page title="Evidence" description="The measurement behind each AGC rule.">
  <p class="source-note">
    Rendered from <a href={`${REPO_URL}/blob/${AGC.current}/EVIDENCE.md`}>EVIDENCE.md at {AGC.current}</a>.
  </p>
  <article class="prose">
    <Content />
  </article>
</Page>
