---
import Page from '../../layouts/Page.astro';
import { AGC, REPO_URL, renderDocument } from '../../lib/agc';

const { Content } = await renderDocument(AGC.current, 'BINDINGS');
---

<Page title="Bindings" description="How an AGC response travels through real runtimes, judgment agents and SARIF.">
  <p class="source-note">
    Rendered from <a href={`${REPO_URL}/blob/${AGC.current}/BINDINGS.md`}>BINDINGS.md at {AGC.current}</a>.
  </p>
  <article class="prose">
    <Content />
  </article>
</Page>
